// NOTA: QUESTA GRAMMATICA È UGUALE A QUELLA IN
// src/pike/grammar.py

start: top_level*

?top_level: function_def
	| statement -> top_level_stmt

// Function Definition
function_def: "defunc" NAME "(" [parameters] ")" ["%" NUM_NAME] "{" body "}"

parameters: par ("," par)*
par: NAME ":" TYPE_NAME

body: statement*

// Statements
?statement: assignment ";"
	| return_stmt ";"
	| print_stmt ";"
	| if_stmt
	| for_stmt
	| expression ";" -> expr_stmt

assignment: NAME ":=" expression
return_stmt: "ret" [expression]
print_stmt: "!" "(" expression ")" -> print_no_nl
	| "!!" "(" expression ")" -> print_nl

if_stmt: "if" "(" expression ")" "{" body "}" ["else" "{" body "}"]

for_stmt: "for" "(" NAME "," number ";" expression ";" number ")" "{" body "}"

// Expressions with Precedence: (<, >) <- (+, -) <- (*, /) <- atom
?expression: comparison

// Precedence 3
?comparison: sum
	| sum "<" sum  -> lt
	| sum ">" sum  -> gt
	| sum "==" sum  -> eq

// Precedence 2
?sum: product
	| sum "+" product -> add
	| sum "-" product -> sub

// Precedence 1
?product: atom
	| product "*" atom -> mul
	| product "/" atom -> div

// Highest precedence
?atom: number
	| string
	| var_load
	| function_call
	| "(" expression ")"

number: NUMBER
string: ESCAPED_STRING
var_load: NAME

function_call : NAME "(" [args] ")"
args: expression ("," expression)*

// Terminals
NAME: /[a-zA-Z_][a-zA-Z0-9_]*/
NUMBER: /\d+(\.\d+)?/
TYPE_NAME: "num" | "str"
NUM_NAME: "num"

%import common.ESCAPED_STRING
%import common.WS
%import common.SH_COMMENT

%ignore WS
%ignore SH_COMMENT