graph TD
    Entry([Entry]) --> Step1_Start[Step 1: Eval start_value]
    Step1_Start --> PreHeader[Current Block: pre_header_block]
    PreHeader -- "Unconditional Branch" --> LoopHeader[Basic Block: loop_header]
    
    subgraph Step2_Setup [Step 2: Iterator Setup]
        LoopHeader --> Phi[PHI Node: node.id_name]
        Phi --> SaveOld[Save old_value from symbol table]
        SaveOld --> UpdateTable[Update symbol table with PHI]
    end

    subgraph Step3_Body [Step 3: Loop Body]
        UpdateTable --> EvalBody[Evaluate node.body]
    end

    subgraph Step4_IncCond [Step 4: Increment & Condition]
        EvalBody --> EvalStep[Eval step_value]
        EvalStep --> CalcNext[fadd: next_value = phi + step_value]
        CalcNext --> EvalEnd[Eval end_condition]
        EvalEnd --> Compare[fcmp: is_loop_active = end_condition != 0]
    end

    subgraph Step5_Branch [Step 5: Branching]
        Compare --> LoopEndBlock[Current Block: loop_end_block]
        LoopEndBlock -- "True (is_loop_active)" --> LoopHeader
        LoopEndBlock -- "False" --> AfterLoop[Basic Block: after_loop]
    end

    subgraph Step6_Cleanup [Step 6: Cleanup]
        AfterLoop --> RestoreTable[Restore old_value to symbol table]
        RestoreTable --> Return([Return 0.0])
    end

    %% PHI Incoming Data Flow Connections
    PreHeader -.-> |Incoming: start_value| Phi
    LoopEndBlock -.-> |Incoming: next_value| Phi