graph TD
    Start([Input: IR string]) --> ParseAsm[Convert IR string<br/>to IR Module]

    subgraph Optimization[" "]
        ParseAsm --> PassManager["Optimize IR Module (optional)"]
    end

    subgraph JIT [ ]
		PassManager --> PrepareJIT
        PrepareJIT[Prepare JIT engine] --> GetAddr[Get Module function address]
        GetAddr --> Wrap[Wrap as Python function]
        Wrap --> Exec[Execute target native code]
    end

    Exec --> End([Return result])