graph TD
    %% Program Structure
    Start((start)) --> TopLevel{toplevel}
    TopLevel --> Def[definition: 'def' ...]
    TopLevel --> Ext[external: 'extern' ...]
    TopLevel --> ExpTop[expression_top]

    %% Definitions
    Def --> Proto[prototype]
    Def --> Exp1[expression]
    Ext --> Proto

    %% The Precedence Ladder
    ExpTop --> Exp1
    Exp1 --> Rel[relation: LESS '<']
    Rel --> Add[add_expr: PLUS '+', MINUS '-']
    Add --> Term[term: STAR '*', SLASH '/']
    Term --> Fact[factor]
    Fact --> Primary{primary}

    %% Atoms / Base Cases
    Primary --> Num((number))
    Primary --> Var((variable))
    Primary --> Parens["( expression )"]
    Primary --> Call[call_expr]
    Primary --> If[if_expr]
    Primary --> For[for_expr]

    %% Complex Constructs
    If --> |condition| ExpIf1[expression]
    If --> |then| ExpIf2[expression]
    If --> |else| ExpIf3[expression]

    For --> |init| ExpFor1[expression]
    For --> |end| ExpFor2[expression]
    For --> |step| ExpFor3[expression]
    For --> |body| ExpFor4[expression]