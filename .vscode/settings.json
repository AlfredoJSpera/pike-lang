{
	"files.exclude": {
		"**/.git": true,
		"**/.svn": true,
		"**/.hg": true,
		"**/.DS_Store": true,
		"**/Thumbs.db": true,
		"__pycache__": true,
		".pytest_cache": true,
		".vscode": true,
		"**/__pycache__": true
	},
	"explorerExclude.backup": {},
	"python.testing.unittestArgs": [
		"-v",
		"-s",
		"./tests",
		"-p",
		"test*.py"
	],
	"python.testing.pytestEnabled": false,
	"python.testing.unittestEnabled": true
}